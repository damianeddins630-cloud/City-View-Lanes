AUTH_SECRET=replace-with-a-long-random-string
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED on Vercel for hours/profile/admin changes to stick:
# Vercel Dashboard → Storage → Blob → Create → Connect to this project
# Newer projects get BLOB_STORE_ID (OIDC). Older ones get BLOB_READ_WRITE_TOKEN.
# Either works. Then Redeploy.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Optional alternate durable storage (instead of / with Blob)
# GITHUB_TOKEN=
# GITHUB_REPO=damianeddins630-cloud/City-View-Lanes
# GITHUB_BRANCH=main

# Shopify — payment / checkout ONLY (never commit real tokens)
# Set these in Vercel Environment Variables. Admin API calls are server-side only.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
# App client secret — used to verify Shopify webhook HMAC signatures
SHOPIFY_WEBHOOK_SECRET=
