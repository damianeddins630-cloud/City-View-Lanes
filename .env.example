AUTH_SECRET=replace-with-a-long-random-string
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (PREFERRED durable store — overrides Blob when set)
# NEVER commit real passwords. Add these in Vercel Environment Variables
# and local .env.local only. Prefer DATABASE_URL (pooled) on Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional aliases from Neon / Vercel Postgres templates:
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_PRISMA_URL=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# Optional image hosting / secondary backup (not required when Neon is set)
# Vercel Dashboard → Storage → Blob → Create → Connect to this project
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Optional alternate durable storage
# GITHUB_TOKEN=
# GITHUB_REPO=damianeddins630-cloud/City-View-Lanes
# GITHUB_BRANCH=main
