AUTH_SECRET=replace-with-a-long-random-string
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED on Vercel for hours/profile/admin changes to stick:
# Vercel Dashboard → Storage → Blob → Create → Connect to this project
# Newer projects get BLOB_STORE_ID (OIDC). Older ones get BLOB_READ_WRITE_TOKEN.
# Either works. Then Redeploy.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Optional alternate durable storage (instead of / with Blob)
# GITHUB_TOKEN=
# GITHUB_REPO=damianeddins630-cloud/City-View-Lanes
# GITHUB_BRANCH=main

# Neon Postgres — NEVER commit real passwords or connection strings
# Add these in Vercel Environment Variables (and local .env.local only).
# Prefer DATABASE_URL (pooled) on Vercel serverless.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional aliases from Neon / Vercel Postgres templates:
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_PRISMA_URL=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=